+/** INFN patch: remember the last stream-channel settings read successfully from
+    the camera. Called with the lock held. Failed reads (e.g. the seconds before a
+    control loss) never overwrite a good value. */
+void ADAravis::refreshReapplyCache() {
+    if (this->device == NULL || !ARV_IS_GV_DEVICE(this->device) || this->connectionValid != 1)
+        return;
+    for (int i = 0; i < 2; i++) {
+        GError *error = NULL;
+        gint64 value = arv_device_get_integer_feature_value(this->device, reapplyFeatures[i], &error);
+        if (error == NULL) {
+            this->reapplyValue[i] = value;
+            this->reapplyValid[i] = 1;
+        } else {
+            g_clear_error(&error);
+        }
+    }
+}
