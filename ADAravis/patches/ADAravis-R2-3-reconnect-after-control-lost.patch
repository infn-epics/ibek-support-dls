+/** INFN patch: reconnect after aravis reported control loss, without an IOC restart.
+    Called from run() without the lock. Restores the stream-channel settings and the
+    acquisition state the camera had when control was lost. */
+void ADAravis::tryReconnect() {
+    static const char *functionName = "tryReconnect";
+    epicsTimeStamp now;
+
+    epicsTimeGetCurrent(&now);
+    if (epicsTimeDiffInSeconds(&now, &this->lastReconnectAttempt) < this->reconnectDelay)
+        return;
+    this->lastReconnectAttempt = now;
+
+    this->lock();
+    if (this->reconnectAcquire < 0) {
+        getIntegerParam(ADAcquire, &this->reconnectAcquire);
+        asynPrint(this->pasynUserSelf, ASYN_TRACE_ERROR,
+            "%s::%s: camera %s: control lost (acquire=%d), reconnecting\n",
+            driverName, functionName, this->cameraName, this->reconnectAcquire);
+    }
+    setIntegerParam(ADStatus, ADStatusDisconnected);
+    setStringParam(ADStatusMessage, "Control lost, reconnecting");
+    callParamCallbacks();
+
+    /* The camera may still treat the old session as its controller; release it so
+       the new session gets control now rather than after the camera heartbeat timeout. */
+    if (this->device != NULL && ARV_IS_GV_DEVICE(this->device))
+        arv_gv_device_leave_control(ARV_GV_DEVICE(this->device), NULL);
+
+    asynStatus status = this->connectToCamera();
+    if (status == asynSuccess && this->connectionValid == 1 && this->device != NULL) {
+        int newStream = 0;
+        for (int i = 0; i < 2; i++) {
+            if (!this->reapplyValid[i]) continue;
+            GError *error = NULL;
+            gint64 current = arv_device_get_integer_feature_value(this->device, reapplyFeatures[i], &error);
+            g_clear_error(&error);
+            if (current != this->reapplyValue[i]) {
+                arv_device_set_integer_feature_value(this->device, reapplyFeatures[i],
+                                                     this->reapplyValue[i], &error);
+                asynPrint(this->pasynUserSelf, ASYN_TRACE_ERROR,
+                    "%s::%s: camera %s: %s was %lld after reconnect, restored %lld%s%s\n",
+                    driverName, functionName, this->cameraName, reapplyFeatures[i],
+                    (long long) current, (long long) this->reapplyValue[i],
+                    error ? " FAILED: " : "", error ? error->message : "");
+                if (error == NULL && i == 0) newStream = 1;
+                g_clear_error(&error);
+            }
+        }
+        if (newStream) this->makeStreamObject();
+        this->reconnectPending = 0;
+        this->reconnectDelay = RECONNECT_DELAY_MIN;
+        if (this->reconnectAcquire == 1) {
+            if (this->startCapture() == asynSuccess) setIntegerParam(ADAcquire, 1);
+        }
+        asynPrint(this->pasynUserSelf, ASYN_TRACE_ERROR,
+            "%s::%s: camera %s: reconnected%s\n", driverName, functionName, this->cameraName,
+            this->reconnectAcquire == 1 ? ", acquisition restarted" : "");
+        setStringParam(ADStatusMessage, "Reconnected after control loss");
+        this->reconnectAcquire = -1;
+    } else {
+        this->connectionValid = 0;
+        setIntegerParam(ADStatus, ADStatusDisconnected);
+        this->reconnectDelay = this->reconnectDelay * 2 > RECONNECT_DELAY_MAX ?
+                               RECONNECT_DELAY_MAX : this->reconnectDelay * 2;
+        asynPrint(this->pasynUserSelf, ASYN_TRACE_ERROR,
+            "%s::%s: camera %s: reconnect failed, next attempt in %.0f s\n",
+            driverName, functionName, this->cameraName, this->reconnectDelay);
+    }
+    callParamCallbacks();
+    this->unlock();
+}
